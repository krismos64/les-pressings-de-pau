// Hébergement Cloudflare Workers Static Assets (site 100 % statique, pas de code Worker).
// Déploiement par GitHub Actions : à configurer au moment de la mise en ligne.
{
  "name": "les-pressings-de-pau",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
