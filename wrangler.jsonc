// Hébergement Cloudflare Workers Static Assets (site 100 % statique, pas de code Worker).
// Déploiement par GitHub Actions (job « deployer » de la CI) sur main et chaque nuit.
// Adresse provisoire : *.workers.dev, en noindex via public/_headers.
{
  "name": "les-pressings-de-pau",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
