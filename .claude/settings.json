{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": null,
    "pr": null
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run verif-publication:*)",
      "Bash(npm test:*)",
      "Bash(npx astro:*)",
      "Bash(npx prettier:*)",
      "Bash(codex exec:*)",
      "Bash(codex review:*)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:schema.org)",
      "mcp__astro-docs__*",
      "mcp__cloudflare-docs__*"
    ],
    "ask": ["Bash(npx wrangler deploy:*)", "Bash(wrangler deploy:*)"]
  },
  "enabledMcpjsonServers": ["astro-docs", "cloudflare-docs"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/anti-cadratin.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rappel-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/astro-check-stop.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/journal-demarrage.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
