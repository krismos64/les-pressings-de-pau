---
import { Image } from "astro:assets";

import type { Visuel } from "../lib/images.ts";

interface Props {
  visuel: Visuel | undefined;
  class?: string;
  sizes?: string;
  priorite?: boolean;
}

const {
  visuel,
  class: classe = "",
  sizes = "(min-width: 768px) 33vw, 100vw",
  priorite = false,
} = Astro.props;
---

{visuel ? (
  <figure class:list={["relative overflow-hidden", classe]}>
    <Image
      src={visuel.src}
      alt={visuel.alt}
      widths={[400, 640, 960]}
      sizes={sizes}
      class="h-full w-full object-cover"
      loading={priorite ? "eager" : "lazy"}
      fetchpriority={priorite ? "high" : "auto"}
    />
    {visuel.provisoire && (
      <figcaption class="absolute top-2 left-2 rounded bg-black/70 px-2 py-1 text-xs font-semibold text-white">
        Image provisoire
      </figcaption>
    )}
  </figure>
) : (
  <div
    class:list={[
      "flex items-center justify-center bg-fond-doux text-sm",
      classe,
    ]}
    aria-hidden="true"
  >
    Photo à venir
  </div>
)}
